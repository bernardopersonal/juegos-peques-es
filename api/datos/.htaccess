# Datos de la sala del 1 contra 1: solo los lee y escribe api/sala.php desde el disco.
# Nadie puede abrir nada de esta carpeta por URL (Apache 2.4 y 2.2).
# Es la protección de verdad. Si no se aplicase, los .php tienen una guarda y nombres que no se
# pueden adivinar (no se leería nada ni se podrían buscar códigos), pero sí se vería qué existe.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
