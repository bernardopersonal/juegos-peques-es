{
  "name": "juegos-peques",
  "private": true,
  "description": "Juegos educativos en español para peques (trazar, contar, sonidos, sílabas, palabras y días de la semana), con voz y una batalla de premio. Web estática sin dependencias.",
  "license": "MIT AND CC-BY-NC-4.0",
  "homepage": "https://bernardopersonal.github.io/juegos-peques-es/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bernardopersonal/juegos-peques-es.git"
  },
  "scripts": {
    "start": "npx --yes serve -l 8080 .",
    "voces": "node scripts/voces.mjs",
    "audios": "node scripts/generar-audios.mjs",
    "audios:simular": "node scripts/generar-audios.mjs --dry-run",
    "video": "node scripts/hacer-video.mjs",
    "video:prueba": "node scripts/hacer-video.mjs --sin-voz",
    "video:dias": "node scripts/hacer-video-dias.mjs",
    "video:dias:prueba": "node scripts/hacer-video-dias.mjs --sin-voz"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  }
}
